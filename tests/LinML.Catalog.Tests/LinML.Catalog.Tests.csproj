<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LinML.Catalog\LinML.Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalog references only the managed API; tests supply the native
         ORT the way a host application does. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\real\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\real\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
