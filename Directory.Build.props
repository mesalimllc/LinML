<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: Missing XML comment — allowed during scaffold; add docs before publish -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Deterministic builds -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>

    <!-- Locked-mode restore (CI uses locked mode; lock files are committed) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Publish RID: every lock file includes RID-specific native assets so
         locked-mode restore stays valid for both plain and -r restores. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>

    <!-- Packaging: only projects that opt in (IsPackable=true) are published,
         to GitHub Packages by .github/workflows/publish-packages.yml. The
         workflow overrides Version from the release tag. -->
    <IsPackable>false</IsPackable>
    <VersionPrefix>0.5.0</VersionPrefix>
    <Authors>LinML Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/trackdubllc/LinML</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/trackdubllc/LinML</PackageProjectUrl>

  </PropertyGroup>

</Project>
