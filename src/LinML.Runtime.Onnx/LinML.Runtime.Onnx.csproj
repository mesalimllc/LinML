<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LinML.Runtime.Onnx</RootNamespace>
    <Description>LinML ONNX Runtime adapter: provider discovery, session factory, and inference.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinML.Runtime.Onnx.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinML.Contracts\LinML.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NOTE: Do NOT also reference Microsoft.ML.OnnxRuntime: its CPU-only
         libonnxruntime.so shadows the GPU build's library and hides the
         CUDA EP. The Gpu package already includes the CPU EP. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
