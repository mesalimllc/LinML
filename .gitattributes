# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.nupkg binary
*.snupkg binary

# ONNX models
*.onnx binary

# Shell scripts
*.sh text eol=lf
